# =============================================================================
# VIBE E-COMMERCE ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update the values for your environment.
# NEVER commit the actual .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# DJANGO CORE SETTINGS
# -----------------------------------------------------------------------------
# Generate a new secret key for production: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-here-change-in-production
DEBUG=True
SITE_URL=http://localhost:8000

# Allowed hosts (comma-separated for multiple)
ALLOWED_HOSTS=127.0.0.1,localhost

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Set to 'postgresql' for production, 'sqlite' for development
DATABASE_ENGINE=sqlite

# PostgreSQL Configuration (required when DATABASE_ENGINE=postgresql)
POSTGRES_DB=vibe_ecommerce
POSTGRES_USER=vibe_user
POSTGRES_PASSWORD=your-secure-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection pooling (seconds to keep connections alive)
DB_CONN_MAX_AGE=60

# SSL Configuration (set to 'true' for production cloud databases)
POSTGRES_SSL=false
POSTGRES_SSL_CERT=

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION (Caching, Sessions, Celery)
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
REDIS_SESSION_URL=redis://127.0.0.1:6379/2
REDIS_CHANNEL_URL=redis://127.0.0.1:6379/3

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=VIBE E-Commerce <noreply@vibe-ecommerce.com>

# -----------------------------------------------------------------------------
# PAYMENT CONFIGURATION (Stripe)
# -----------------------------------------------------------------------------
STRIPE_API_KEY_PUBLISHABLE=pk_test_xxxxx
STRIPE_API_KEY_HIDDEN=sk_test_xxxxx
STRIPE_ENDPOINT_SECRET=whsec_xxxxx

# -----------------------------------------------------------------------------
# SEARCH CONFIGURATION (Elasticsearch)
# -----------------------------------------------------------------------------
ELASTICSEARCH_HOST=localhost:9200

# -----------------------------------------------------------------------------
# IMAGE OPTIMIZATION (ImageKit)
# -----------------------------------------------------------------------------
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS (Firebase)
# -----------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# ERROR TRACKING (Sentry)
# -----------------------------------------------------------------------------
SENTRY_DSN=

# =============================================================================
# PRODUCTION POSTGRESQL SETUP GUIDE
# =============================================================================
#
# 1. Install PostgreSQL:
#    - Windows: Download from https://www.postgresql.org/download/windows/
#    - Ubuntu: sudo apt-get install postgresql postgresql-contrib
#    - macOS: brew install postgresql
#
# 2. Create the database and user:
#    ```sql
#    -- Connect to PostgreSQL as superuser
#    CREATE DATABASE vibe_ecommerce;
#    CREATE USER vibe_user WITH PASSWORD 'your-secure-password';
#    GRANT ALL PRIVILEGES ON DATABASE vibe_ecommerce TO vibe_user;
#
#    -- For Django to create/modify tables
#    ALTER USER vibe_user CREATEDB;
#
#    -- Grant schema permissions (PostgreSQL 15+)
#    \c vibe_ecommerce
#    GRANT ALL ON SCHEMA public TO vibe_user;
#    ```
#
# 3. Update this .env file:
#    DATABASE_ENGINE=postgresql
#    POSTGRES_PASSWORD=your-secure-password
#
# 4. Run migrations:
#    python manage.py migrate
#
# 5. (Optional) Load existing data:
#    python manage.py loaddata backup.json
#
# =============================================================================
# PERFORMANCE TUNING (postgresql.conf recommendations)
# =============================================================================
#
# For a production server with 4GB RAM:
#   shared_buffers = 1GB
#   effective_cache_size = 3GB
#   maintenance_work_mem = 256MB
#   checkpoint_completion_target = 0.9
#   wal_buffers = 16MB
#   default_statistics_target = 100
#   random_page_cost = 1.1
#   effective_io_concurrency = 200
#   work_mem = 16MB
#   min_wal_size = 1GB
#   max_wal_size = 4GB
#   max_worker_processes = 4
#   max_parallel_workers_per_gather = 2
#   max_parallel_workers = 4
#
# =============================================================================
